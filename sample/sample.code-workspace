{
	// Workspace de prueba para la extensión workspace-style.
	"folders": [
		{ "path": "api-backend" },
		{ "path": "web-frontend" },
		{ "path": "shared-lib" }
	],
	"settings": {
		"workspaceStyle.folders": {
			"api-backend": {
				"color": "#e34234",
				"badge": "🚀",
				"label": "BACK"
			},
			"web-frontend": {
				"color": "#1d8fe1",
				"badge": "⭐",
				"label": "FRONT"
			},
			"shared-lib": {
				"color": "#5a3fd6",
				"badge": "🤖",
				"label": "SHARED"
			}
		},
		"workbench.colorCustomizations": {
			"workspaceStyle.slot1": "#e34234",
			"workspaceStyle.slot2": "#1d8fe1",
			"workspaceStyle.slot3": "#5a3fd6"
		},
		"workbench.editor.customLabels.patterns": {
			"api-backend/**/?*.*": "${filename}.${extname} BACK",
			"api-backend/**": "${filename} BACK",
			"web-frontend/**/?*.*": "${filename}.${extname} FRONT",
			"web-frontend/**": "${filename} FRONT",
			"shared-lib/**/?*.*": "${filename}.${extname} SHARED",
			"shared-lib/**": "${filename} SHARED"
		},
		"workspaceStyle.managedLabelPatterns": [
			"api-backend/**/?*.*",
			"api-backend/**",
			"web-frontend/**/?*.*",
			"web-frontend/**",
			"shared-lib/**/?*.*",
			"shared-lib/**"
		]
	}
}
