{
  "name": "workspace-style",
  "displayName": "Workspace Style – Repo Tab Colors (Multi-root)",
  "publisher": "pablohenriquez",
  "description": "%extension.description%",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ph-dom/workspace-style.git"
  },
  "bugs": {
    "url": "https://github.com/ph-dom/workspace-style/issues"
  },
  "homepage": "https://github.com/ph-dom/workspace-style#readme",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Themes",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "multi-root",
    "workspace",
    "monorepo",
    "multiple repositories",
    "tabs",
    "tab color",
    "editor tabs",
    "folder color",
    "repo color",
    "badge",
    "emoji",
    "label",
    "explorer",
    "status bar",
    "workspace color",
    "organize",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "workspaceStyle.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Workspace Style",
        "icon": "$(symbol-color)"
      },
      {
        "command": "workspaceStyle.resync",
        "title": "%command.resync.title%",
        "category": "Workspace Style"
      }
    ],
    "configuration": {
      "title": "Workspace Style",
      "properties": {
        "workspaceStyle.folders": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "markdownDescription": "%config.folders.description%",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "description": "%config.folders.color.description%"
              },
              "badge": {
                "type": "string",
                "maxLength": 2,
                "description": "%config.folders.badge.description%"
              },
              "emoji": {
                "type": "string",
                "description": "%config.folders.emoji.description%"
              },
              "label": {
                "type": "string",
                "description": "%config.folders.label.description%"
              },
              "labelPosition": {
                "type": "string",
                "enum": [
                  "prefix",
                  "suffix"
                ],
                "default": "suffix",
                "enumDescriptions": [
                  "%config.folders.labelPosition.prefix%",
                  "%config.folders.labelPosition.suffix%"
                ]
              }
            }
          }
        },
        "workspaceStyle.decorations.color": {
          "type": "boolean",
          "default": true,
          "description": "%config.decorations.color.description%"
        },
        "workspaceStyle.decorations.badge": {
          "type": "boolean",
          "default": true,
          "description": "%config.decorations.badge.description%"
        },
        "workspaceStyle.tabLabels.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.tabLabels.enabled.description%"
        },
        "workspaceStyle.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.enabled.description%"
        },
        "workspaceStyle.managedLabelPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.managedLabelPatterns.description%"
        }
      }
    },
    "colors": [
      {
        "id": "workspaceStyle.slot1",
        "description": "%color.slot1.description%",
        "defaults": {
          "dark": "#E34234",
          "light": "#E34234",
          "highContrast": "#E34234",
          "highContrastLight": "#E34234"
        }
      },
      {
        "id": "workspaceStyle.slot2",
        "description": "%color.slot2.description%",
        "defaults": {
          "dark": "#1E56D9",
          "light": "#1E56D9",
          "highContrast": "#1E56D9",
          "highContrastLight": "#1E56D9"
