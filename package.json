{
  "name": "workspace-style",
  "displayName": "Workspace Style",
  "description": "Identifica con colores, badges y prefijos de qué carpeta o repositorio viene cada pestaña en un workspace multi-root.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "workspaceStyle.openSettings",
        "title": "Personalizar carpetas",
        "category": "Workspace Style",
        "icon": "$(symbol-color)"
      },
      {
        "command": "workspaceStyle.resync",
        "title": "Re-aplicar estilos",
        "category": "Workspace Style"
      }
    ],
    "configuration": {
      "title": "Workspace Style",
      "properties": {
        "workspaceStyle.folders": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "markdownDescription": "Estilo por carpeta del workspace (la clave es el nombre de la carpeta). Se edita desde **Workspace Style: Personalizar carpetas**.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "description": "Color hex del nombre en pestañas, Explorer y barra de estado."
              },
              "badge": {
                "type": "string",
                "maxLength": 2,
                "description": "Badge corto (máx. 2 caracteres o 1 emoji)."
              },
              "emoji": {
                "type": "string",
                "description": "Emoji agregado al nombre de la pestaña."
              },
              "label": {
                "type": "string",
                "description": "Texto/abreviatura agregado al nombre de la pestaña."
              },
              "labelPosition": {
                "type": "string",
                "enum": [
                  "prefix",
                  "suffix"
                ],
                "default": "suffix"
              }
            }
          }
        },
        "workspaceStyle.decorations.color": {
          "type": "boolean",
          "default": true,
          "description": "Colorear el nombre de los archivos según su carpeta."
        },
        "workspaceStyle.decorations.badge": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar el badge de la carpeta en pestañas y Explorer."
        },
        "workspaceStyle.tabLabels.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Agregar emoji/texto al nombre de las pestañas mediante `#workbench.editor.customLabels.patterns#`."
        },
        "workspaceStyle.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar la carpeta del archivo activo en la barra de estado."
        },
        "workspaceStyle.managedLabelPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Uso interno: patrones de `workbench.editor.customLabels.patterns` generados por la extensión. No editar."
        }
      }
    },
    "colors": [
      {
        "id": "workspaceStyle.slot1",
        "description": "Workspace Style: color de carpeta #1",
        "defaults": {
          "dark": "#E34234",
          "light": "#E34234",
          "highContrast": "#E34234",
          "highContrastLight": "#E34234"
